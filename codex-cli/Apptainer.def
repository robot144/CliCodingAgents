Bootstrap: docker
From: ubuntu:24.04

%labels
    Maintainer openai-codex
    Description Apptainer image with OpenAI Codex CLI installed

%environment
    export PATH=/root/.pixi/bin:/usr/local/bin:$PATH

%files
    ../opt/bootstrap-workspace.sh /opt/bootstrap-workspace.sh
    ../opt/AGENTS.md /opt/AGENTS.md

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        epiphany-browser \
        git \
        libx11-6 \
        libxext6 \
        libxrender1 \
        nodejs \
        npm \
        poppler-utils \
        ripgrep \
	bubblewrap # Codex-specific: limit Codex access; otherwise the packaged version is used.
    # gh from github repo to get more recent version
    apt-get install -y wget gpg

    mkdir -p -m 755 /etc/apt/keyrings
    wget -nv -O /tmp/githubcli.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg
    cp /tmp/githubcli.gpg /etc/apt/keyrings/githubcli-archive-keyring.gpg
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg

    mkdir -p -m 755 /etc/apt/sources.list.d
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list
    apt-get update
    apt-get install -y gh

    rm -rf /var/lib/apt/lists/*

    # Codex-specific installer.
    npm install -g @openai/codex

    # Install pixi (Python/multi-language package manager)
    curl -fsSL https://pixi.sh/install.sh | bash

%runscript
    # Codex-specific command entrypoint.
    exec /usr/local/bin/codex "$@"
